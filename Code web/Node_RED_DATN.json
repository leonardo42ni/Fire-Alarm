  {
    "id": "fn-proc-h2",
    "type": "function",
    "z": "flow-001",
    "name": "Process Router_H2 Data",
    "func": "var d = msg.payload;\nvar temp = parseFloat((d.temperature || 0).toFixed(1));\nvar hum  = parseFloat((d.humidity    || 0).toFixed(1));\nvar co2  = parseInt(d.co2  || 0);\nvar tvoc = parseInt(d.tvoc || 0);\nvar last_seen = d.last_seen || '---';\nreturn [\n  [{payload: temp,      topic: 'Router_H2'}],\n  [{payload: hum,       topic: 'Router_H2'}],\n  [{payload: co2,       topic: 'Router_H2'}],\n  [{payload: tvoc,      topic: 'Router_H2'}],\n  [{payload: last_seen}],\n  [{payload: 'ping'}]\n];",
    "outputs": 6,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 730,
    "y": 200,
    "wires": [
      ["chart-h2-temp", "text-h2-temp"],
      ["chart-h2-hum",  "text-h2-hum"],
      ["chart-h2-co2",  "text-h2-co2"],
      ["chart-h2-tvoc", "text-h2-tvoc"],
      ["text-h2-seen"],
      ["trig-h2"]
    ]
  },
